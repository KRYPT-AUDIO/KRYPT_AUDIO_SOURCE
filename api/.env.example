# Copy this file to .env on the PHP server. Never commit the real .env.
YOUTUBE_DATA_API_KEY=replace_with_google_cloud_api_key
ALLOWED_ORIGIN=https://krypt-audio.github.io

# Cloud Run audio resolver. Set these after deploying cloud-run-resolver.
KRYPT_RESOLVER_URL=https://krypt-audio-resolver-REPLACE.a.run.app
KRYPT_RESOLVER_TOKEN=replace_with_the_same_long_random_token
